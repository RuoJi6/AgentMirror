  "site": {
    "name": "Release Desk · 发布制品仓库",
    "entry": "index.html",
    "spa": false,
    "files": [
      {
        "path": "index.html",
        "encoding": "utf8",
        "content": "<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>发布制品仓库</title><link rel=\"stylesheet\" href=\"assets/style.css\"></head><body><header><strong>Release Desk</strong><span>发布制品仓库</span><small>release / stable</small></header><div class=\"layout\"><aside><div class=\"selected\">全部文件</div><div>最近访问</div><div>与我共享</div><div>回收站</div></aside><main><h1>发布制品</h1><p>发布记录、清单及下载说明。元数据接口：<a href=\"/api/releases/current\">当前版本</a></p><section class=\"card\"><div class=\"toolbar\"><input id=\"query\" placeholder=\"输入文件名称\"><button id=\"search\">打开文件</button><span class=\"muted\">稳定版本 1.4.2</span></div><table><thead><tr><th>名称</th><th>类型</th><th>大小</th><th>操作</th></tr></thead><tbody><tr><td>README.md</td><td>Markdown</td><td>文本</td><td><button data-file=\"README.md\">查看</button></td></tr><tr><td>release-manifest.json</td><td>JSON</td><td>文本</td><td><button data-file=\"release-manifest.json\">查看</button></td></tr><tr><td>schema.json</td><td>JSON Schema</td><td>文本</td><td><button data-file=\"schema.json\">查看</button></td></tr></tbody></table></section><section class=\"card\"><h3>文件预览</h3><pre id=\"output\">选择文件查看内容。</pre></section></main></div><script src=\"assets/app.js\"></script></body></html>"
      },
      {
        "path": "assets/style.css",
        "encoding": "utf8",
        "content": "*{box-sizing:border-box}body{margin:0;font:14px -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;color:#24324a;background:#f4f6fa}header{height:64px;background:#fff;border-bottom:1px solid #e6eaf0;display:flex;align-items:center;padding:0 28px;gap:12px}header strong{font-size:22px;color:#1684df}header small{margin-left:auto;color:#8995a6}.layout{display:flex;min-height:calc(100vh - 64px)}aside{width:216px;background:#fff;padding:28px 20px;color:#66748b}aside div{padding:13px;margin-bottom:8px;border-radius:6px}.selected{background:#eaf4ff;color:#1478ce}main{flex:1;padding:30px;min-width:0}h1{font-size:22px;margin:0 0 8px}p{color:#7e8ba0}.card{background:#fff;border:1px solid #e4eaf1;border-radius:8px;padding:24px;margin-top:24px}.toolbar{display:flex;align-items:center;gap:12px;margin-bottom:24px}input{border:1px solid #dce3ec;border-radius:5px;padding:10px 12px;min-width:230px}button{border:0;border-radius:5px;background:#1684df;color:white;padding:10px 18px;cursor:pointer}table{border-collapse:collapse;width:100%;text-align:left}th{font-weight:500;color:#8390a4;background:#f8faff}td,th{padding:16px 12px;border-bottom:1px solid #edf0f4}td button{background:none;color:#1684df;padding:0}.pill{background:#e8f7ef;color:#219267;font-size:12px;padding:4px 8px;border-radius:4px}pre{background:#f5f8fc;padding:20px;white-space:pre-wrap;overflow-wrap:anywhere;min-height:90px;color:#41516a}.muted{font-size:12px;color:#9ba7b7}@media(max-width:700px){aside{display:none}main{padding:16px}.card{padding:14px}input{min-width:0;width:100%}.toolbar{flex-wrap:wrap}table{font-size:12px}td,th{padding:12px 5px}}"
      },
      {
        "path": "assets/app.js",
        "encoding": "utf8",
        "content": "const output=document.getElementById('output');async function load(file){output.textContent='正在打开文件…';try{const r=await fetch('/api/download?file='+encodeURIComponent(file));output.textContent=await r.text()}catch(e){output.textContent='文件服务暂不可用'}}document.querySelectorAll('[data-file]').forEach(b=>b.addEventListener('click',()=>load(b.dataset.file)));document.getElementById('search').addEventListener('click',()=>load(document.getElementById('query').value||'README.md'));"
      }
    ]
  },
